<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Your New Password</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .password-box {
            font-size: 18px;
            font-weight: bold;
            color: #007bff;
            text-align: center;
            padding: 20px;
            margin: 20px 0;
            background-color: #f8f9fa;
            border-radius: 5px;
        }
        .warning {
            color: #dc3545;
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Your New Password</h2>
        <p>Your password has been reset successfully. Here is your new password:</p>
        
        <div class="password-box">
            {{newPassword}}
        </div>
        
        <p class="warning">Please change this password immediately after logging in for security reasons.</p>
        
        <p>For security reasons:</p>
        <ul>
            <li>Change this password as soon as you log in</li>
            <li>Do not share this password with anyone</li>
            <li>Delete this email after memorizing or safely storing the password</li>
        </ul>
        
        <p>Best regards,<br>L-Edu Team</p>
    </div>
</body>
</html>
